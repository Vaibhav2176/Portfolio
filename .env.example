# ==============================================================================
# ENVIRONMENT VARIABLE TEMPLATE (Placeholders Only — Never Commit Secrets)
# ==============================================================================

# Server-Side Email Delivery (Gmail SMTP or compatible)
# Note: For Gmail, use an App Password, not your standard account password
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_TO=recipient_email@gmail.com

# Server-Side Optional MongoDB Persistence (Optional)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# Server Port (Local backend server)
PORT=3000

# Client-Side Frontend API Configuration (Optional)
# Leave empty for production Vercel serverless deployments to use relative /api/contact.
# Set to http://localhost:3000 only if running Vite and Express on separate ports locally without the proxy.
VITE_API_URL=
